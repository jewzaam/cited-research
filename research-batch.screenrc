# Generated By: Claude Code (Claude Opus 4.6)
# screenrc for running cited-research in parallel across all Research-*.md briefs
#
# Usage: screen -c research-batch.screenrc
#
# Each window runs claude with the /cited-research skill against one brief.
# Use Ctrl-a n / Ctrl-a p to switch between windows.
# Use Ctrl-a " to see all windows and select one.

startup_message off
defscrollback 10000
hardstatus alwayslastline "%{= kw}%-w%{= BW}%n %t%{-}%+w %= %{= kG}%H"

chdir /home/nmalik/source/cited-research

